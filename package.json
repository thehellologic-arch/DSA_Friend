{
  "name": "reason",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @reason/core build && pnpm --parallel --filter @reason/server --filter @reason/web dev",
    "dev:server": "pnpm --filter @reason/server dev",
    "dev:web": "pnpm --filter @reason/web dev",
    "build": "pnpm --filter @reason/core build && pnpm -r build",
    "start": "node packages/server/dist/index.js",
    "test": "pnpm --filter @reason/core build && pnpm --filter @reason/core test && pnpm --filter @reason/server test"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}
