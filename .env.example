# Preferred for personal use: prepaid credits, no surprise bills, auto model fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash,deepseek/deepseek-chat

# Used only when OPENROUTER_API_KEY is not set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Used only when OPENROUTER_API_KEY and GEMINI_API_KEY are not set.
OLLAMA_BASE_URL=https://sadly-oversight-shun.ngrok-free.dev
OLLAMA_MODEL=gemma4:26b
PORT=3001
DATABASE_URL=postgres://reason:reason@localhost:5432/reason

# Novel approach evaluation rollout: off | shadow | on.
# Production stays off until explicitly set to on.
NOVEL_EVALUATION_MODE=shadow
